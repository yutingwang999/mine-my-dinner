# Copy to .env and fill in the keys. Never put real secrets in this file.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:15433/minemydinner
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:15433/minemydinner_test
GOOGLE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Model IDs. Each must be listed in the catalog in backend/config/models.yaml,
# which holds its price and capabilities. Leave a value empty to use the default there.
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-6-luna
DEEPSEEK_MODEL=deepseek-flash
# Changing the embedding model requires recomputing every stored vector.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
LLM_MONTHLY_CAP_USD=20
EXTRACTION_LOG_MAX_ROWS=500
